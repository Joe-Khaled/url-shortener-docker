# Values one of the team used to run the API directly on their laptop,
# with Postgres and Redis installed locally (no containers).
#
# main.py reads these as real environment variables. Any setting can
# also be read from a file by setting NAME_FILE instead of NAME, e.g.
# DB_PASSWORD_FILE=/run/secrets/db_password
#
# Check every value before reusing it anywhere else.
APP_ENV=development
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=5432
DB_NAME=snip
DB_USER=snip
DB_PASSWORD=changeme-local-only

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

RATE_LIMIT_PER_MINUTE=10

API_PORT = 3000
